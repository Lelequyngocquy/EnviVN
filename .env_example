# ==============================================================================
# EnviVN - Environment Template & Hướng dẫn sử dụng (.env_example)
# ==============================================================================
# 1. Tổng quan:
#    - `.env`        : File cấu hình môi trường chính thức của ứng dụng (được nạp khi chạy).
#                      Chứa toàn bộ URL API và Token bảo mật cá nhân.
#    - `.env_example`: File mẫu (template) này dùng để hướng dẫn và khởi tạo khi clone dự án.
#
# 2. Cách thiết lập khi bắt đầu phát triển (Setup Guide):
#    Bước 1: Tạo bản sao của file này thành file `.env` ở thư mục gốc của dự án:
#            Trên Windows PowerShell:
#            > Copy-Item .env_example .env
#            Trên macOS / Linux:
#            > cp .env_example .env
#    Bước 2: Sử dụng ngay lập tức!
#            - Các API thời tiết (Open-Meteo), chất lượng không khí, bản đồ (OpenStreetMap)
#              và định vị IP đều là dịch vụ công khai miễn phí, đã có sẵn URL mặc định.
#
# 4. Cách sử dụng biến môi trường trong code Flutter:
#    Sử dụng class `EnvConfig` trong `lib/src/core/infrastructure/configs/env_config.dart`:
#    - Lấy URL thời tiết:       `EnvConfig.openMeteoWeatherBaseUrl`
#    - Lấy URL chất lượng KK:   `EnvConfig.openMeteoAirQualityBaseUrl`
#    - Lấy URL OpenStreetMap:   `EnvConfig.osmTileUrl`
#    - Lấy giá trị bất kì:      `EnvConfig.get('TÊN_BIẾN', defaultValue: '...')`
#
# ==============================================================================

# 1. Ứng dụng & Môi trường chạy
APP_NAME=EnviVN
APP_ENV=development
APP_DEBUG=true

# 2. Open-Meteo Weather API
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com

# 3. Open-Meteo Air Quality API
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com

# 4. Open-Meteo Geocoding API
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com

# 5. IP Geolocation API
IP_API_BASE_URL=http://ip-api.com/json

# 6. Bản đồ nền OpenStreetMap
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=com.envivn.envivn

# 7. NASA FIRMS API (Vệ tinh NOAA-20 / NOAA-21)
# Key lấy tại: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_FIRMS_MAP_KEY=

